# Copy to deploy/.env. Prod needs DOMAIN + DNS; dev (compose.dev.yml) needs none of these.
DOMAIN=wiki.home.example.com
DNS_PROVIDER=cloudflare
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
DEFAULT_MODEL=anthropic/claude-sonnet-5
APP_UID=1000
APP_GID=1000
# Dev only: clone from local bare repos in tmp/dev/remotes instead of GitHub.
# GIT_REMOTE_BASE=file:///remotes/
