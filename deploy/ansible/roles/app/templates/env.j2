# Rendered by Ansible (role app) for target {{ target }}; compose reads it from the project dir.
APP_VERSION={{ app_release }}
DOMAIN={{ domain }}
TLS_MODE={{ tls_mode }}
BIND_IP={{ bind_ip }}
HTTPS_PORT={{ https_port }}
APP_UID={{ deploy_uid }}
APP_GID={{ deploy_gid }}
GIT_AUTHOR_NAME={{ git_author_name | to_json(ensure_ascii=False) }}
GIT_AUTHOR_EMAIL={{ git_author_email | to_json(ensure_ascii=False) }}
DEFAULT_MODEL={{ default_model }}
TZ={{ timezone }}
