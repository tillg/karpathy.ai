#!/usr/bin/env bash
# Pings the healthchecks.io check in /etc/karpathy-heartbeat.url; /fail (with the reason) as soon as a
# container of karpathy-app or karpathy-monitoring isn't running, or is unhealthy (architecture §4.3).
set -uo pipefail
url="$(cat /etc/karpathy-heartbeat.url)"
problems=""
for project in karpathy-app karpathy-monitoring; do
  states="$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Names}} {{.State}} {{.Status}}')"
  [ -n "$states" ] || { problems+="$project: no containers"$'\n'; continue; }
  while read -r name state status; do
    if [ "$state" != running ]; then problems+="$name: $state"$'\n'
    elif [[ "$status" == *"(unhealthy)"* ]]; then problems+="$name: unhealthy"$'\n'
    fi
  done <<< "$states"
done
if [ -n "$problems" ]; then
  curl -fsS -m 10 --retry 3 --data-raw "$problems" "$url/fail" >/dev/null
else
  curl -fsS -m 10 --retry 3 "$url" >/dev/null
fi
