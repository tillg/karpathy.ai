# Copy to deploy/opencode.env: provider API keys, opencode service only (never the backend).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Web search (Exa). Optional; recommended for production (anonymous access is rate-limited).
# EXA_API_KEY=
# Per-turn limits on the AI's web calls (default 20 each; applied when opencode restarts).
# WEB_FETCH_CAP=20
# WEB_SEARCH_CAP=20
