# Dev: Caddy's internal CA on localhost; the PWA comes from the Vite dev server (HMR).
{
	local_certs
	skip_install_trust
}
# Container healthcheck (compose): plain HTTP, loopback only, answered by Caddy itself, so
# "healthy" means Caddy runs, not that the backend does (the backend has its own healthcheck).
http://:8081 {
	bind 127.0.0.1
	respond "ok"
}
https://localhost {
	tls internal
	reverse_proxy /api/* backend:8787 {
		flush_interval -1
	}
	reverse_proxy web:5173
}
